{"root":{"data":{"id":"dijynvqyhww0","created":1778920430270,"text":"对比剂"},"children":[{"data":{"id":"dikwe6t0oco0","created":1779015588434,"text":"X线对比剂"},"children":[{"data":{"id":"dikxy0f9dww0","created":1779019962935,"text":"种类及理化特性"},"children":[{"data":{"id":"dikxypdr4000","created":1779020017263,"text":"阴性对比剂"},"children":[{"data":{"id":"dikxytm71340","created":1779020026481,"text":"空气,氧气,二氧化碳,水等"},"children":[]}]},{"data":{"id":"dikxyrbs4ps0","created":1779020021498,"text":"阳性对比剂"},"children":[{"data":{"id":"dikxzbn8kw80","created":1779020065726,"text":"钡剂"},"children":[{"data":{"id":"dil39irvbb40","created":1779034970435,"text":"医用硫酸钡","note":"对人体组织刺激性小\n"},"children":[]}]},{"data":{"id":"dil39b0fcv40","created":1779034953538,"text":"碘剂","expandState":"expand"},"children":[{"data":{"id":"diky0e8hu8w0","created":1779020149729,"text":"无机碘"},"children":[{"data":{"id":"dil3cdinzzk0","created":1779035194087,"text":"碘化钠","note":"对人体组织刺激性大\n"},"children":[]}]},{"data":{"id":"diky0cdjopk0","created":1779020145681,"text":"有机碘"},"children":[{"data":{"id":"dil3b14jr1c0","created":1779035088747,"text":"水溶性"},"children":[{"data":{"id":"dil3cj7jlqo0","created":1779035206475,"text":"经肾排泄","expandState":"expand"},"children":[{"data":{"id":"dil3sgn9w2o0","created":1779036454723,"text":"离子型对比剂","expandState":"expand","note":"溶液中有离子存在的对比剂"},"children":[{"data":{"id":"dil3gsqfye00","created":1779035540665,"text":"离子单体","note":"1. 每个分子有3个碘原子,一个羧基,没有羟基.\n2. 每3个碘原子有2个离子,比率为1.5.\n3. 口服对比剂主要用于静脉肾盂造影.\n\n* 甲基泛影葡胺\n* 复方泛影葡胺\n* 碘酞葡胺"},"children":[]},{"data":{"id":"dil3hj0rops0","created":1779035597886,"text":"离子二聚体型","note":"1. 每个分子内有6个碘原子,一个羧基,一个羟基.\n2. 溶液中每6个碘原子有2个离子\n\n* 碘克酸\n* 泛影钠"},"children":[]}]},{"data":{"id":"dil3sguebc80","created":1779036455153,"text":"非离子型对比剂","expandState":"expand","note":"溶液中无离子存在的对比剂"},"children":[{"data":{"id":"dil3gwo8rg00","created":1779035549239,"text":"非离子单体"},"children":[]},{"data":{"id":"dil3hvbjt2g0","created":1779035624659,"text":"非离子二聚体"},"children":[]}]}]},{"data":{"id":"dil3d0izxdk0","created":1779035244173,"text":"经肝排泄"},"children":[{"data":{"id":"dil3i18crqw0","created":1779035637527,"text":"口服"},"children":[]},{"data":{"id":"dil3i28m16g0","created":1779035639719,"text":"静脉"},"children":[]}]}]},{"data":{"id":"dil3cm4ct7k0","created":1779035212812,"text":"脂溶性"},"children":[{"data":{"id":"dil3i896wg80","created":1779035652815,"text":"油脂类","note":"碘化油,碘苯脂,乙碘油."},"children":[]}]}]}]}]}]},{"data":{"id":"dikxy4ipsbs0","created":1779019971851,"text":"引入途径"},"children":[]},{"data":{"id":"dikxy6mgnfc0","created":1779019976431,"text":"不良反应及防止"},"children":[]}]},{"data":{"id":"dikwe93zdz40","created":1779015593451,"text":"MRI对比剂"},"children":[]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}