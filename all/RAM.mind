{"root":{"data":{"id":"dke8ozq1y480","created":1785651685526,"text":"RAM(随机存取内存)"},"children":[{"data":{"id":"dkebfzaf32w0","created":1785659442632,"text":"结构","expandState":"expand"},"children":[{"data":{"id":"dkeaxpgrj0o0","created":1785658010693,"text":"SRAM静态随机存取内存","note":"SRAM 由晶体管和基础的翻转电路构成，每个存储单元由 6 个晶体管和一个复杂的内部架构组成，它能够与 PC 的电路速度保持一致。\n速度快,容量小, "},"children":[]},{"data":{"id":"dkeaxr4hg9k0","created":1785658014304,"text":"DRAM动态随机存取内存"},"children":[{"data":{"id":"dkeb7z3kj000","created":1785658815305,"text":"同步SDRAM"},"children":[{"data":{"id":"dkebgje5bi80","created":1785659486394,"text":"SDR SDRAM"},"children":[]},{"data":{"id":"dkebgn8qi540","created":1785659494773,"text":"DDR SDRAM"},"children":[]},{"data":{"id":"dkebh652w4w0","created":1785659535911,"text":"GDDR SDRAM"},"children":[]}]},{"data":{"id":"dkeb80cbrs00","created":1785658818011,"text":"异步ADRAM"},"children":[]}]}]},{"data":{"id":"dkebhgvx1080","created":1785659559302,"text":"规格"},"children":[{"data":{"id":"dkebhp86k8g0","created":1785659577458,"text":"SIMM"},"children":[]},{"data":{"id":"dkebhv3lfbs0","created":1785659590241,"text":"RIMM"},"children":[]},{"data":{"id":"dkebhwpfxew0","created":1785659593739,"text":"SORIMM"},"children":[]},{"data":{"id":"dkebhjbxlq80","created":1785659564624,"text":"DIMM-台式机"},"children":[]},{"data":{"id":"dkebhmbtmhk0","created":1785659571147,"text":"SO-DIMM-笔记本"},"children":[]}]}]},"template":"right","theme":"fresh-blue","version":"1.4.43"}